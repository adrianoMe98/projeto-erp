COMPOSE_PROJECT_NAME=erp-development
ERP_ENVIRONMENT=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=gerada-automaticamente-pelo-erpctl
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8021,http://192.168.1.50:8021
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_AUTO_MIGRATE=1
ERP_PORT=8021
PIX_ENABLED=1

DB_NAME=erp_dev_db
DB_USER=erp_dev_admin
DB_PASSWORD=gerada-automaticamente-pelo-erpctl
DB_HOST=db
DB_PORT=5432

PIX_SIMULATOR_WEBHOOK_TOKEN=gerado-automaticamente-pelo-erpctl
DEFAULT_FROM_EMAIL=erp-dev@localhost
LOG_LEVEL=DEBUG
