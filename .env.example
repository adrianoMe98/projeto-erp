COMPOSE_PROJECT_NAME=erp-production
ERP_ENVIRONMENT=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=erp.local,192.168.1.50,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://erp.local,http://192.168.1.50:8020
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_AUTO_MIGRATE=1
ERP_PORT=8020
PIX_ENABLED=0

DB_NAME=erp_db
DB_USER=erp_admin
DB_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432

PIX_SIMULATOR_WEBHOOK_TOKEN=troque-o-token-do-simulador
DEFAULT_FROM_EMAIL=erp@seudominio.local
LOG_LEVEL=INFO
